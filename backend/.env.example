# ==========================================
# SMARTMEAL BACKEND — biến môi trường
# Sao chép thành `backend/.env` (đã .gitignore) rồi điền giá trị thật. KHÔNG commit file `.env`.
#
# Dùng cho cả hai cách chạy:
#   - Docker (khuyên dùng): ở thư mục gốc repo chạy `docker compose up -d --build` — một lệnh dựng PostgreSQL
#     và API. Compose đọc file này cho API; chuỗi kết nối được compose thay bằng container `postgres`.
#   - Chạy tay (debug/hot reload): `docker compose up -d postgres` rồi `dotnet run --project backend/SmartMeal.API`.
#     Program.cs tự nạp file này.
# Biến môi trường đặt khi chạy được ưu tiên hơn giá trị trong file này.
# ==========================================

# 1. Database (PostgreSQL) — khớp với container `postgres` trong docker-compose.yml (cổng 5432 trên máy)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=SmartMealDb;Username=postgres;Password=postgrespassword

# 2. JWT Authentication
# BẮT BUỘC tự sinh khóa ngẫu nhiên (>= 32 ký tự), ví dụ:
#   openssl rand -base64 48            (Linux/macOS/Git Bash)
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])   (PowerShell)
# Giá trị CHANGE_ME... chỉ chạy được ở môi trường Development; môi trường khác sẽ từ chối khởi động.
Jwt__Key=CHANGE_ME_generate_a_random_value_of_at_least_32_characters
Jwt__Issuer=SmartMealBackend
Jwt__Audience=SmartMealMobile
# Thời hạn access token (phút) và refresh token (ngày)
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=30

# 3. Google Gemini AI API — để trống thì ở Development AI trả dữ liệu mẫu (isDemo).
#    Đã có key mà Gemini lỗi thì API báo lỗi (502), không trả dữ liệu mẫu (trừ khi Ai__AllowDemoFallback=true).
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
Gemini__ApiKey=
Gemini__Model=gemini-3.8-flash
# Model dự phòng (cách nhau bằng dấu phẩy) khi model chính bị Google ngừng (404) hoặc quá tải (429/5xx). Để rỗng để tắt.
Gemini__FallbackModels=gemini-flash-lite-latest
# Tùy chọn (đã có mặc định): mức "suy nghĩ" của model (low nhanh gấp đôi; rỗng = mặc định của model), thời gian chờ
# mỗi model trước khi chuyển sang model dự phòng và tổng thời gian chờ (phải nhỏ hơn EXPO_PUBLIC_AI_TIMEOUT_MS của app).
# Gemini__ThinkingLevel=low
# Gemini__AttemptTimeoutSeconds=25
# Gemini__TimeoutSeconds=50

# 4. Google Sign-In — Web OAuth 2.0 Client ID (same client as EXPO_PUBLIC_GOOGLE_CLIENT_ID)
# Authorized JavaScript origins must include the actual Expo Web origin (e.g. http://localhost:8082).
Google__ClientId=

# 5. Thanh toán PayOS (chuyển khoản VietQR) — lấy ở https://my.payos.vn → Kênh thanh toán → Thông tin tích hợp.
# KHÔNG commit khóa thật. Để trống = tắt phương thức PAYOS (máy chủ trả 503).
# Đăng ký URL webhook: https://<máy-chủ>/api/subscription/payos-webhook (máy dev không nhận được webhook thì app vẫn
# hỏi trạng thái qua GET /api/subscription/check-status/{orderCode}).
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=

# 6. Thanh toán chuyển khoản qua SePay (https://my.sepay.vn) — tiền vào thẳng tài khoản ngân hàng đã liên kết với SePay.
# Tài khoản nhận (BankCode theo danh sách ngân hàng của SePay, vd. MBBank, VCB, TPBank):
SePay__BankCode=
SePay__AccountNumber=
SePay__AccountName=
# Xác nhận tiền vào — cần ít nhất một (KHÔNG commit khóa thật):
#  - WebhookApiKey: my.sepay.vn → WebHooks → thêm webhook, kiểu xác thực "API Key", URL https://<máy-chủ>/api/subscription/sepay-webhook
#  - ApiToken: my.sepay.vn → API Access → tạo token; máy chủ tự hỏi giao dịch khi webhook không tới được (máy dev).
SePay__WebhookApiKey=
SePay__ApiToken=
# Tiền tố mã thanh toán trong nội dung chuyển khoản (đặt trùng "cấu trúc mã thanh toán" trên SePay):
# SePay__PaymentCodePrefix=SM

# 7. Tùy chọn
# Bật Swagger ngoài Development (mặc định chỉ bật ở Development)
# Swagger__Enabled=true
# Origin được phép gọi API từ trình duyệt (Expo web), phân tách bằng dấu phẩy. App native không cần.
# Cors__AllowedOrigins=http://localhost:8081
# Gửi email OTP thật (xác minh đăng ký, quên mật khẩu). Gmail: User = địa chỉ Gmail, Password = App Password 16 ký tự
# (bật Xác minh 2 bước rồi tạo tại https://myaccount.google.com/apppasswords), From trống = dùng User.
# Để trống User = chỉ ghi log (ở Development log có cả mã OTP).
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__User=
Smtp__Password=
Smtp__From=
# Tùy chọn: bắt xác minh email khi đăng ký (mặc định: bật khi đã cấu hình SMTP).
# Auth__RequireEmailVerification=true
# Tài khoản Quản trị viên cho Admin Web. Development tự tạo admin@smartmeal.com / Admin@123456 nếu để trống;
# môi trường thật CHỈ tạo admin khi đặt mật khẩu ở đây (không có mật khẩu mặc định). Email mặc định admin@smartmeal.com.
# Seed__AdminPassword=
# Seed__AdminEmail=
# Tra mã vạch chưa có trong CSDL qua Open Food Facts (công khai, không cần khóa). Đặt false nếu máy chủ không ra Internet.
# OpenFoodFacts__Enabled=true
