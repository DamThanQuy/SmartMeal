# SmartMeal Mobile — biến môi trường.
# Copy file này thành `.env` (KHÔNG commit `.env` — .gitignore đã chặn) rồi chỉnh giá trị.
# Biến phải có prefix EXPO_PUBLIC_: Expo inline chúng vào bundle lúc build nên có thể bị lộ —
# KHÔNG đặt secret/API key ở đây. Đổi xong phải restart Metro: npx expo start --clear

# URL backend (ĐÃ gồm /api). Chọn 1 theo nơi chạy app:
#   Android emulator:                        http://10.0.2.2:5000/api
#   iOS simulator / web:                     http://localhost:5000/api
#   Điện thoại thật (Expo Go, cùng Wi-Fi):    http://<IP-LAN-máy-tính>:5000/api
# Điện thoại thật cần BE nghe trên mọi interface (dotnet run --urls http://0.0.0.0:5000 hoặc
# docker compose up) và Windows Firewall cho phép cổng 5000 — xem docs/fetch-api/part1 §3.1.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# true  = dùng dữ liệu giả lập, không cần backend (có thể đổi MOCK_SCENARIO ở màn Dev).
# false = gọi API thật (hàm nào BE chưa hỗ trợ vẫn rơi về mock, xem docs/fetch-api).
EXPO_PUBLIC_USE_MOCK_API=false

# Timeout (ms): API thường / các endpoint AI (Gemini có thể mất 5–20s).
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_AI_TIMEOUT_MS=60000

# development | staging | production (production tắt các nhánh chỉ dành cho dev như activate-mock).
EXPO_PUBLIC_APP_ENV=development
