# SmartMeal Mobile — biến môi trường.
# Copy file này thành `.env` (KHÔNG commit `.env` — .gitignore đã chặn) rồi chỉnh giá trị.
# Biến phải có prefix EXPO_PUBLIC_: Expo inline chúng vào bundle lúc build nên có thể bị lộ —
# KHÔNG đặt secret/API key ở đây. Đổi xong phải restart Metro: npx expo start --clear

# URL backend (ĐÃ gồm /api). Để TRỐNG khi chạy dev bằng Expo: app tự dùng IP của máy đang chạy Metro
# (máy chạy backend) + EXPO_PUBLIC_API_PORT (mặc định 5000), nên điện thoại thật chỉ cần CÙNG MẠNG với máy
# tính (cùng router — IP cùng dải, vd. đều 192.168.100.x), không phải sửa IP khi đổi Wi-Fi.
# Chỉ đặt khi cần trỏ tới chỗ khác:
#   Android emulator:          http://10.0.2.2:5000/api
#   Máy chủ thật / staging:    https://api.example.com/api
# Điện thoại thật cần BE nghe trên mọi interface (docker compose up, hoặc dotnet run --urls
# http://0.0.0.0:5000) và Windows Firewall cho phép cổng 5000 — xem docs/fetch-api/part1 §3.1.
# Chạy `npx expo start --tunnel` thì không tự lấy được IP (app gọi localhost) — khi đó phải đặt URL này.
EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_API_PORT=5000

# Timeout (ms): API thường / các endpoint AI (Gemini có thể mất 5–20s).
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_AI_TIMEOUT_MS=60000

# development | staging | production (production tắt các nhánh chỉ dành cho dev như activate-mock).
EXPO_PUBLIC_APP_ENV=development

# Google Identity Services (Web OAuth 2.0 Client ID, not a secret).
# Must match Google__ClientId in backend/.env and authorize the exact web origin.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
